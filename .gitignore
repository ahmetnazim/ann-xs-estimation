# Scientific ML Git Exclusions
.env
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Large Artifacts & Data
data/raw/
data/processed/
data/processed/runs/archives/
data/checkpoints/
*.nc
*.h5
*.zarr
*.tiff
*.pt
*.onnx
scaler.pkl
.DS_Store

# Notebook and tabular/geospatial intermediates (Phase 0 audit, ADL-009)
.ipynb_checkpoints/
*.parquet
*.gpkg
*.gdb/

# Tool caches and build outputs (Phase 4; caches are also redirected outside Drive by scripts/dev_env.sh)
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/

# Model artefacts and binary arrays (Phase 4; DVC-managed under data/ from Phase 5)
*.ckpt
*.safetensors
*.pkl
*.joblib
*.npy
*.npz
*.tif
*.7z

# Experiment trackers and logs (Phase 4)
mlruns/
wandb/
*.log

# Secrets: `.env` is ignored above; variants too, but keep a template trackable (Phase 4)
.env.*
!.env.example

# Editors and macOS / Google Drive artefacts (Phase 4)
.idea/
.vscode/
Icon?

# NOT ignored on purpose (Phase 4 gate check): dvc.yaml, dvc.lock, params.yaml, .dvcignore,
# uv.lock, .python-version, reports/*.json, docs/tables/*.csv. `*.csv` is not ignored globally.

# Phase 8 event outputs (docs/3 13.4; dvc.yaml audit stage, cache: false) are committed with the ledger
!reports/results/*.parquet
